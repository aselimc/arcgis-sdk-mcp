{
  "operation": {
    "operationId": "beaconsNearPointGet",
    "path": "/beacons/near-point",
    "endpoint": "https://beacons-api.example.com/v1/beacons/near-point",
    "method": "get",
    "summary": "Find beacons close to a coordinate.",
    "description": "The `/beacons/near-point` request lists the beacons inside a circle\naround a coordinate.\n\nYou must send the `x` and `y` values. You may also send:\n\n- A search radius\n- One or more kind ids\n\n**Note**: results are ordered by distance.",
    "queryParameters": [
      {
        "in": "query",
        "name": "x",
        "shortDescription": "Longitude of the search centre.",
        "description": "Longitude of the search centre, in decimal degrees.",
        "example": -4.5,
        "required": true,
        "type": "number",
        "displayType": "%%[XCoord](/beacons/types/#xcoord)%%",
        "minimum": -180,
        "maximum": 180
      },
      {
        "in": "query",
        "name": "kindIds",
        "description": "Keeps only beacons of these kinds.\n\nA beacon matches when it has _any_ of the ids. Useful values:\n\n- `tower` for masonry towers\n- `buoy` for floating marks",
        "example": ["tower", "buoy"],
        "required": false,
        "type": "array",
        "displayType": "[%%[KindId](/beacons/types/#kindid)%%]"
      },
      {
        "in": "query",
        "name": "pageSize",
        "description": "How many beacons one response holds.",
        "example": 10,
        "required": false,
        "default": 10,
        "type": "integer",
        "displayType": "integer",
        "minimum": 1,
        "maximum": 20
      },
      {
        "in": "query",
        "name": "f",
        "description": "Response format, `json` or `pjson` (a | b).",
        "required": false,
        "default": "json",
        "type": "string",
        "displayType": "string",
        "enum": ["json", "pjson"]
      },
      {
        "in": "query",
        "name": "tags",
        "description": "Free-text tags.",
        "required": false,
        "type": "array",
        "displayType": "[string]"
      }
    ],
    "bodyParameters": [],
    "pathParameters": [],
    "headerParameters": [
      {
        "in": "header",
        "name": "X-Request-Id",
        "description": "Echoed back in the response.",
        "required": false,
        "type": "string",
        "displayType": "string"
      }
    ],
    "examples": [
      {
        "language": "curl",
        "content": "curl 'https://beacons-api.example.com/v1/beacons/near-point?x=-4.5&y=48.4' \\\n  -H 'Authorization: Bearer <TOKEN>'"
