    <members>
        <member name="T:Example.Tides.TideClock">
            <summary>
            Follows the tides of one harbour. Create it with
            <see cref="M:Example.Tides.TideClock.#ctor(System.String)"/>.
            </summary>
            <remarks>
            <para>Readings come from a <see cref="T:Example.Tides.Gauge"/>.</para>
            <para>Supported units:</para>
            <list type="bullet">
                <item><description><c>m</c> for metres</description></item>
                <item><term>ft</term><description>for feet</description></item>
            </list>
            </remarks>
            <example>
            Reading the next high tide:
            <code>
            var clock = new TideClock("brest");

            Console.WriteLine(clock.NextHighTide);
            </code>
            </example>
            <seealso href="https://example.com/tides">Tide primer</seealso>
        </member>
        <member name="M:Example.Tides.TideClock.#ctor(System.String)">
            <summary>Creates a clock for a harbour.</summary>
            <param name="harbour">Identifier of the harbour.</param>
            <exception cref="T:System.ArgumentException">The harbour is unknown.</exception>
        </member>
        <member name="P:Example.Tides.TideClock.NextHighTide">
