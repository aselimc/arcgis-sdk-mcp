        <member name="M:Example.Tides.TideClock.Sample``1(System.Collections.Generic.IEnumerable{``0},System.Nullable{System.Int32},System.Double[]@)">
            <summary>
            Heights at several moments. Uses <paramref name="precision"/> digits and
            returns <see langword="null"/> for moments outside the record.
            </summary>
            <typeparam name="T">The moment type.</typeparam>
            <param name="moments">The moments to sample.</param>
            <param name="precision">Digits after the decimal point.</param>
            <param name="heights">Receives the heights.</param>
            <returns><b>true</b> when every moment was found.</returns>
        </member>
