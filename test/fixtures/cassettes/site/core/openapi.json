                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "get": {
                "operationId": "getEvent",
                "description": "Returns one event by its id.",
                "parameters": [
                  {
                    "name": "expand",
                    "in": "query",
                    "schema": {
                      "type": "boolean"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "The event"
                  }
                }
              },
              "delete": {
                "operationId": "deleteEvent",
                "summary": "Delete an event",
                "deprecated": true,
                "responses": {
                  "204": {
                    "description": "Deleted"
                  }
                }
              },
              "x-internal": true
            },
            "/api/events/v1/broken": "not an object"
          },
          "components": {
            "schemas": {
              "Event": {
                "type": "object",
                "description": "A scheduled widget event.",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                }
              },
              "EventList": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        }
