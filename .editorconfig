root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Golden files and recorded fixtures must stay byte-exact.
[test/fixtures/**]
insert_final_newline = unset
trim_trailing_whitespace = false
end_of_line = unset
